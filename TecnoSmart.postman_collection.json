        { "name": "DELETE eliminar registro de inventario", "request": { "method": "DELETE", "url": { "raw": "{{base_url}}/api/inventario/{{inventario_id}}", "host": ["{{base_url}}"], "path": ["api", "inventario", "{{inventario_id}}"] } }, "response": [] }
      ]
    },
    {
      "name": "CRUD - carrito-service",
      "item": [
        { "name": "GET carrito del usuario", "request": { "method": "GET", "url": { "raw": "{{base_url}}/api/carrito/usuario/{{usuario_id}}", "host": ["{{base_url}}"], "path": ["api", "carrito", "usuario", "{{usuario_id}}"] } }, "response": [] },
        {
          "name": "POST agregar item al carrito",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"usuarioId\": {{usuario_id}},\n  \"productoId\": {{producto_id}},\n  \"cantidad\": 1\n}" },
            "url": { "raw": "{{base_url}}/api/carrito", "host": ["{{base_url}}"], "path": ["api", "carrito"] },
            "description": "Copia el 'id' devuelto y actualiza 'carrito_id' si lo vas a usar en el DELETE."
          },
          "response": []
        },
        { "name": "DELETE quitar item del carrito", "request": { "method": "DELETE", "url": { "raw": "{{base_url}}/api/carrito/{{carrito_id}}", "host": ["{{base_url}}"], "path": ["api", "carrito", "{{carrito_id}}"] } }, "response": [] }
      ]
    },
    {
      "name": "CRUD - pedidos-service",
      "item": [
        { "name": "GET todos los pedidos", "request": { "method": "GET", "url": { "raw": "{{base_url}}/api/pedidos", "host": ["{{base_url}}"], "path": ["api", "pedidos"] } }, "response": [] },
        {
          "name": "POST crear pedido",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"usuarioId\": {{usuario_id}},\n  \"items\": [\n    { \"productoId\": {{producto_id}}, \"cantidad\": 1 }\n  ]\n}" },
            "url": { "raw": "{{base_url}}/api/pedidos", "host": ["{{base_url}}"], "path": ["api", "pedidos"] },
            "description": "Copia el 'id' devuelto y actualiza 'pedido_id' si lo vas a usar en el DELETE o en pagos/despacho."
          },
          "response": []
        },
        { "name": "DELETE eliminar pedido", "request": { "method": "DELETE", "url": { "raw": "{{base_url}}/api/pedidos/{{pedido_id}}", "host": ["{{base_url}}"], "path": ["api", "pedidos", "{{pedido_id}}"] } }, "response": [] }
      ]
    },
    {
      "name": "CRUD - pagos-service",
      "item": [
        { "name": "GET todos los pagos", "request": { "method": "GET", "url": { "raw": "{{base_url}}/api/pagos", "host": ["{{base_url}}"], "path": ["api", "pagos"] } }, "response": [] },
        {
          "name": "POST crear pago",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"pedidoId\": {{pedido_id}},\n  \"metodo\": \"WEBPAY\",\n  \"monto\": 19990,\n  \"estado\": \"APROBADO\",\n  \"fechaPago\": \"2026-07-12T12:00:00\"\n}" },
            "url": { "raw": "{{base_url}}/api/pagos", "host": ["{{base_url}}"], "path": ["api", "pagos"] },
