        { "name": "DELETE eliminar despacho", "request": { "method": "DELETE", "url": { "raw": "{{base_url}}/api/despachos/{{despacho_id}}", "host": ["{{base_url}}"], "path": ["api", "despachos", "{{despacho_id}}"] } }, "response": [] }
      ]
    },
