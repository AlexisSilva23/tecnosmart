          },
          "response": []
        },
        { "name": "DELETE eliminar pago", "request": { "method": "DELETE", "url": { "raw": "{{base_url}}/api/pagos/{{pago_id}}", "host": ["{{base_url}}"], "path": ["api", "pagos", "{{pago_id}}"] } }, "response": [] }
      ]
    },
    {
      "name": "CRUD - despacho-service",
      "item": [
        { "name": "GET todos los despachos", "request": { "method": "GET", "url": { "raw": "{{base_url}}/api/despachos", "host": ["{{base_url}}"], "path": ["api", "despachos"] } }, "response": [] },
        {
          "name": "POST crear despacho",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"pedidoId\": {{pedido_id}},\n  \"direccion\": \"Av. de Prueba 123\",\n  \"comuna\": \"Santiago\",\n  \"estado\": \"PENDIENTE\",\n  \"fechaProgramada\": \"2026-07-20\"\n}" },
            "url": { "raw": "{{base_url}}/api/despachos", "host": ["{{base_url}}"], "path": ["api", "despachos"] },
            "description": "Copia el 'id' devuelto y actualiza 'despacho_id' si lo vas a usar en el DELETE."
          },
          "response": []
